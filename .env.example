# ---------------------------------------------------------------------------
# serveme for Team Frontress — docker compose configuration
#
#   cp .env.example .env
#   $EDITOR .env          # fill in the four REQUIRED values
#   docker compose up -d
#
# Everything below is read by docker-compose.yml. Nothing here needs Rails
# credentials or a master key; see RAILS_MASTER_KEY at the bottom for what you
# give up by not having one.
# ---------------------------------------------------------------------------

# === REQUIRED ==============================================================

# Signs cookies and sessions. Changing it logs everybody out.
# Generate one:  openssl rand -hex 64
SECRET_KEY_BASE=

# Steam Web API key, from https://steamcommunity.com/dev/apikey
# Steam sign-in does not work without it.
STEAM_API_KEY=

# Postgres password. Only used inside the compose network, but it is still a
# password: generate it, do not type "password".
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# The address users reach this site at, as they type it. It ends up in emails,
# in redirects, and in the reservation details the game client is given, so a
# wrong value produces links that go nowhere.
SITE_URL=https://serveme.example.org


# === PORTS =================================================================

# What the reverse proxy in front of this should point at. Only this port and
# the log port below are published; everything else stays on the internal
# compose network.
SERVEME_HTTP_PORT=3000

# Game servers send their console logs here over UDP. It has to be reachable
# from every server in the pool, so if there is a firewall, this is the hole.
SERVEME_LOG_PORT=40001

# Bind published ports to one interface. 127.0.0.1 is right when a proxy on the
# same host is the only thing that should reach Rails. Use 0.0.0.0 to expose it
# directly. The log port ignores this — game servers are remote by definition.
SERVEME_BIND=127.0.0.1


# === DATABASE AND REDIS ====================================================

POSTGRES_USER=serveme
POSTGRES_DB=serveme_production

# Pin the images. Postgres will refuse to start on a data directory written by
# a different major version, so do not change this after the first `up`
# without dumping and restoring.
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine

# Override only if you point at a database or redis outside this compose file.
# Setting DATABASE_URL overrides POSTGRES_* entirely.
# DATABASE_URL=postgres://user:password@some-host:5432/serveme_production
# REDIS_URL=redis://some-host:6379/0


# === RAILS =================================================================

RAILS_ENV=production
RAILS_LOG_TO_STDOUT=1
RAILS_MAX_THREADS=12

# Sidekiq worker concurrency.
SIDEKIQ_CONCURRENCY=10

# Where uploaded maps are unpacked before being sent to servers.
MAPS_DIR=/rails/tmp/maps


# === GAME SERVERS ==========================================================
#
# Game servers are containers. That is the only supported way to run one here:
# the image carries the game, the Steam Linux Runtime, the rulesets and the
# coordinator agent, so a machine that can run a container can host a match
# without being set up for the game at all.

# The image. Built by the game repository's CI from docker/frontress-server.
FRONTRESS_SERVER_IMAGE=ghcr.io/gru2007/frontress-server:latest

# Run game servers on this machine's own docker daemon. Requires the docker
# socket, which docker-compose.yml already mounts into web and sidekiq.
#
# Unset it if game servers only ever run on remote docker hosts (added under
# /admin/docker_hosts) or on machines you manage yourself.
FRONTRESS_LOCAL_DOCKER=1

# How many game servers this machine may run at once.
FRONTRESS_LOCAL_DOCKER_MAX_CONTAINERS=4

# The host's docker group id, so the unprivileged user inside the web and
# sidekiq containers may use the mounted socket:
#   getent group docker | cut -d: -f3
DOCKER_GID=999

# The address of THIS machine as a game server container sees it. Containers
# run on the host network, so they need a real address to call back on, not
# the compose-internal one. Usually the host's LAN or public IP.
DOCKER_HOST_IP=
CLOUD_CALLBACK_HOST=

# The build the fleet should be running, as steam.inf's PatchVersion (the
# VERSION file in the dedicated payload). Leave empty and no server is ever
# considered outdated -- which is the right default until you have a release
# pipeline feeding it.
FRONTRESS_SERVER_VERSION=

# Where clients download maps they do not have. Leave empty and players only
# get maps that are already in the image.
FRONTRESS_FASTDL_URL=

# The maps this site may hand out, space or comma separated. It is what the map
# picker shows, what /api/maps.txt serves to each container at boot, and what
# "does this map exist" is checked against -- so a map missing from here cannot
# be reserved.
#
# Empty means every map named in config/league_maps.yml. With object storage
# configured (see below) the bucket is listed instead and this is ignored.
FRONTRESS_MAPS=

# The map a server boots on when a reservation does not ask for one.
FRONTRESS_DEFAULT_MAP=koth_product_final

# Game Server Login Tokens for AppID 5147520, from
# https://steamcommunity.com/dev/managegameservers
#
# Without one a server runs but players connect with no inventory. A token
# belongs to one running server at a time, so this is a list: give it as many
# tokens as this machine runs containers.
#   FRONTRESS_GSLT=token1,token2,token3,token4
FRONTRESS_GSLT=


# === GAME COORDINATOR ======================================================
#
# The matchmaking coordinator (services/coordinator in the game repository).
# It books servers here through the API, and the agent inside each container
# reports the match result back to it.
#
# Both values must match the coordinator's own config: the URL is where it
# listens, the secret is its `secret` field. Without them, reservations still
# work and matchmaking has nothing to talk to.
FRONTRESS_COORDINATOR_URL=
FRONTRESS_COORDINATOR_SECRET=


# === OPTIONAL ==============================================================

# Rails encrypted credentials. Without it, everything in
# config/credentials/production.yml.enc is simply unavailable: Cloudflare,
# Stripe, PayPal, Discord, the cloud-server providers and logs.tf/demos.tf
# uploads. Reservations, servers and Steam login do not need it.
#
# If you have config/credentials/production.key, put its contents here.
RAILS_MASTER_KEY=

# Discord bot. Only started with:  docker compose --profile discord up -d
DISCORD_BOT_TOKEN=

# MaxMind licence key, for `docker compose run --rm web bin/rails maxmind:fetch`
# to download the GeoIP databases into doc/. Free key from maxmind.com.
MAXMIND_LICENSE_KEY=

# Where uploads go: map uploads, reservation zip files. Empty means the local
# disk (the `storage` volume), which is what a deployment without Rails
# credentials wants. Set to a service from config/storage.yml -- `cloudflare`,
# `minio`, `seaweedfs` -- once you have credentials for one.
ACTIVE_STORAGE_SERVICE=
ZIPFILE_STORAGE_SERVICE=

# Error reporting. Leave empty to disable.
SENTRY_DSN=
